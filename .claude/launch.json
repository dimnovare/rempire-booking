{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "booking-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3400
    },
    {
      "name": "barber-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "--port", "3410"],
