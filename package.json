{
  "name": "rempire-booking",
  "version": "0.1.0",
  "private": true,
  "description": "REMPIRE booking: client booking, Renat's admin, the barber PWA, product sales and invoices. Replaces Altegio and Isolta.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3400",
    "build": "next build",
    "postbuild": "node tools/migrate.mjs --if-configured && node tools/seed-demo.mjs --if-enabled && node tools/bootstrap-owner.mjs --if-configured",
    "start": "next start --port 3400",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "migrate": "node tools/migrate.mjs",
    "seed:demo": "node tools/seed-demo.mjs",
    "check:noindex": "node tools/check-noindex.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
