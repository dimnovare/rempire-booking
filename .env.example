# Env var NAMES only. Values go into Vercel (Project → Settings →
# Environment Variables), never into git or chat.

# Search engines. Leave unset on staging. Set to exactly "yes" only when the
# app moves to rempire.ee (src/lib/indexing.ts).
ALLOW_INDEXING=
# The client address: every link a client gets, and link previews
# (src/lib/site.ts). Unset = staging, https://rempire-booking.diipsolutions.eu.
# At the move: https://book.rempire.ee.
SITE_URL=
# The staff address: the admin and the barber app, staff letters, Google's
# way back. Unset = SITE_URL (one address for both, as on staging today).
# Set with SITE_URL on another host, each host serves its own half
# (src/lib/hosts.ts, docs/launch.md B3). At the move: https://staff.rempire.ee.
STAFF_URL=

# Database (docs/staging-setup.md). Railway's DATABASE_PUBLIC_URL, as it is.
DATABASE_URL=
# Railway's Postgres has its own CA: paste it (PEM) here; the chain is then
# checked, the host name is not. Last resort: DATABASE_SSL_NO_VERIFY=1
# (encrypted, not verified).
DATABASE_SSL_CA=
DATABASE_SSL_NO_VERIFY=
DATABASE_POOL_MAX=
# pg (default) | pglite (in memory) | auto (pg when DATABASE_URL is set).
# CI deploys staging with auto.
DB_DRIVER=
# yes = load the demo barbers and services (staging, local runs). Never on rempire.ee.
SEED_DEMO=
# Local in-memory runs only (DB_DRIVER=pglite + SEED_DEMO=yes): yes = fake
# logins at example.test (e-mail code in the server log) and fake visits for
# today and tomorrow, to try the barber app at /b.
DEMO_LOGINS=
# Which business this app serves (default: rempire).
BUSINESS_SLUG=

# Staff login (A4). Owner logins, created on deploy if missing. One e-mail,
# or a list split by «;», «,» or spaces: every listed address becomes an
# owner with ADMIN_BOOTSTRAP_PASSWORD (one shared admin password). An owner
# without a password gets it; a password already set is never overwritten.
# Mark the password sensitive.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# E-mail (A4 codes, A6). Resend needs both: the key, and EMAIL_FROM on a
# domain verified in that Resend account, e.g. «REMPIRE <noreply@…>».
# Without both, production says «not set up»; locally letters go to the
# server log. EMAIL_TRANSPORT=console forces that.
RESEND_API_KEY=
EMAIL_FROM=
# «Открыт» on a sent invoice (025_mail_opened.sql): the signing secret
# («whsec_…») of the Resend webhook to /api/webhooks/resend, event
# «email.opened». Opens are reported only with open tracking on for the
# sending domain. Unset: the webhook answers 503 and nothing is marked.
RESEND_WEBHOOK_SECRET=
EMAIL_TRANSPORT=
# Google login (A4, not wired yet: src/lib/auth/google.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMS (A6) through Messaggio, on Renat's own account (decision 30;
# src/lib/sms.ts). Both are needed; without them production leaves SMS
# queued and local runs print them to the server log.
# MESSAGGIO_LOGIN: the project's login from the Messaggio dashboard, sent as
# the «Messaggio-Login» header. It is the only credential: mark it sensitive.
# MESSAGGIO_SENDER: the sender's API code for the SMS channel (its «from»),
# from the same dashboard once Messaggio has approved the name «REMPIRE».
MESSAGGIO_LOGIN=
MESSAGGIO_SENDER=
# Staging test run (until ALLOW_INDEXING=yes): only these numbers really get
# an SMS, the testers' own, E.164, split by «,»; every other number is
# printed to the log instead (spaces inside a number are fine). Unset: none
# is sent on staging.
SMS_TEST_TO=
# SMS_TRANSPORT=console prints instead of sending, even with Messaggio set.
SMS_TRANSPORT=
# The outbox cron (A6): /api/cron/outbox wants «Authorization: Bearer <this>».
CRON_SECRET=
# Push to the barber app (B5). Dim makes the pair once (npx web-push
# generate-vapid-keys, on his own machine) and puts it into Vercel; the
# private key is sensitive. Without both, «Включить уведомления» stays grey
# and nothing is queued. VAPID_SUBJECT: a mailto: or https: contact for the
# push services (default: the site address).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The shop link (Phase C, src/lib/shop.ts). Unset = the fake shop of demo
# products: staging never calls the live shop until Dim says so.
# SHOP_API_URL is the shop's origin (https). SHOP_API_SECRET is the READ key
# (lookup, search, photo match): one random value Dim makes; the shop holds
# the same value as BOOKING_API_SECRET (or BOOKING_API_READ_SECRET).
# SHOP_API_READ_SECRET is the same key under its newer name and wins if set.
# Mark them sensitive.
SHOP_API_URL=
SHOP_API_SECRET=
# The WRITE key (barber sales become shop orders): 32+ characters, never the
# read key; the shop holds it as BOOKING_API_WRITE_SECRET. Production only,
# from the move on; never on staging (docs/phase-c.md, docs/move-log.md S1).
SHOP_API_WRITE_SECRET=
# Sales go to the shop only with SHOP_SALES=on (the move, set last, after the
# write key and ALLOW_INDEXING=yes). Off (the staging test run): sales stay in
# booking as «тест»; lookups and photo match still read SHOP_API_URL. Even
# on, the test run never sells into a shop that is not on localhost.
SHOP_SALES=

# The staging test run (src/lib/test-run.ts): until ALLOW_INDEXING=yes, every
# letter that is not a login code and not for a staff login goes to the shop
# inbox instead. TEST_MAIL_TO overrides that inbox; unset is fine.
TEST_MAIL_TO=
